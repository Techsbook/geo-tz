{
  "name": "mamluk/geo-tz",
  "description": "Find the timezone at a specific GPS coordinate (PHP port of node-geo-tz)",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "symfony/cache": "^7.0",
    "psr/simple-cache": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "GeoTz\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GeoTz\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "update-data": "php scripts/update-data.php"
  }
}
